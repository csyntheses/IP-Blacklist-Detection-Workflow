# Breakout IP Blacklist Monitor — Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# AbuseIPDB API key (free tier: 1,000 checks/day)
# Get yours at: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=your_api_key_here

# Microsoft Teams webhook URL (via Power Automate Workflows)
# Setup: Teams channel → Workflows → "Post to a channel when a webhook request is received"
TEAMS_WEBHOOK_URL=https://your-power-automate-webhook-url-here

# The breakout/egress IP to monitor
MONITOR_IP=your_IP_to_monitor

# Alert only when the abuse confidence score exceeds this value
# Set this to your current baseline score to avoid alerting on known/existing reports
SCORE_THRESHOLD=27

# How far back (in days) to look for reports
MAX_AGE_DAYS=90
